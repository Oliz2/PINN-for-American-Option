# Allowlist: this folder also contains thesis material that is not part of the repository.
# Everything is ignored except the paths explicitly re-included below.
/*
!/.gitignore
!/README.md
!/docs/

# ---- C++ project: only the build file and the sources (no build/, no old CSV/Excel results) ----
!/C++_Project/
/C++_Project/*
!/C++_Project/CMakeLists.txt
!/C++_Project/src/

# ---- Java project (Maven): pom.xml and sources only (no target/, logs, IDE files) ----
!/Java_Project/
/Java_Project/*
!/Java_Project/pom.xml
!/Java_Project/src/

# ---- PINN interface: source files only (no runs/, no result images, no old Italian copies) ----
!/Charts_python_PINN/
/Charts_python_PINN/*
!/Charts_python_PINN/app.py
!/Charts_python_PINN/charts.py
!/Charts_python_PINN/results.py
!/Charts_python_PINN/runner.py
!/Charts_python_PINN/settings.py
!/Charts_python_PINN/requirements.txt
!/Charts_python_PINN/README.md
!/Charts_python_PINN/example_config.json

# ---- Monte Carlo interface: source files and Java sources (no runs/, no compiled classes) ----
!/Charts_python_MonteCarlo/
/Charts_python_MonteCarlo/*
!/Charts_python_MonteCarlo/app.py
!/Charts_python_MonteCarlo/charts_mc.py
!/Charts_python_MonteCarlo/results_mc.py
!/Charts_python_MonteCarlo/runner_mc.py
!/Charts_python_MonteCarlo/settings_mc.py
!/Charts_python_MonteCarlo/requirements.txt
!/Charts_python_MonteCarlo/README.md
!/Charts_python_MonteCarlo/java/
/Charts_python_MonteCarlo/java/*
!/Charts_python_MonteCarlo/java/src/

# ---- Anywhere ----
__pycache__/
*.pyc
*.class
.vscode/
.idea/
